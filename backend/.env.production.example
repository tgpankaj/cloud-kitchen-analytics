# ============================================================
# KitchenIQ Pro — Production Environment
# ============================================================
# NEVER commit the real .env file with actual secrets.
# Use this template as reference for production deployment.
# ============================================================

# --- Flask ---
SECRET_KEY=replace-with-strong-random-32-char-string
FLASK_ENV=production
PORT=5000

# --- Database (from Render/Railway/Neon) ---
# Format: postgresql://user:password@host:port/dbname
# Use ?sslmode=require for managed services
DATABASE_URL=postgresql://user:password@host:5432/kitcheniq?sslmode=require

# --- CORS (comma-separated origins) ---
# Production: your real frontend domain
CORS_ORIGINS=https://app.kitcheniq.in,https://kitcheniq.pages.dev

# --- Rate Limiting (use Redis in production if available) ---
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=500 per hour

# --- Gunicorn ---
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# --- Razorpay (future) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Observability (optional) ---
LOG_LEVEL=info
SENTRY_DSN=