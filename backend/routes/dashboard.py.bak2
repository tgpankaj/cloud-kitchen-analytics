def dashboard_home():

    return jsonify({
        "service":
            "KitchenIQ Dashboard",

        "status":
            "ok",

        "endpoints": [
            "/kpis",
            "/trends",
            "/top-dishes",
            "/recent-orders",
            "/profit-margins",
            "/all"
        ]
    })


# ========================================================
# KITCHENIQ PRO — DASHBOARD SUMMARY
# GET /api/dashboard/summary
# ========================================================
#
# Ye endpoint naye KitchenIQ Pro dashboard ke liye
# saara data ek hi call mein return karta hai.
#
# Existing endpoints ko break nahi karta.
# ========================================================

from services.dashboard_service import (
    get_kpi_summary,
    get_trend,
    get_platform_breakdown,
    get_integration_status,
)


@dashboard_bp.route("/summary", methods=["GET"])
@token_required
def summary():
    """
    KitchenIQ Pro dashboard ke liye consolidated data.

    Query params:
        ?kitchen_id=N   (optional, defaults to first kitchen)
        ?days=7         (default 7, allowed 7/30/90)

    Returns:
        {
          "period_days": 7,
          "kpis": {...},
          "trend": {"labels": [], "revenue": [], "profit": []},
          "platforms": {"labels": [], "gross_revenue": [], "commission": [], "detail": []},
          "integrations": [...]
        }
    """
    kitchen_id = get_kitchen_id(request)
    if not kitchen_id:
        return jsonify({"error": "No kitchen found"}), 404

    # Validate days (7 / 30 / 90 only)
    try:
        days = int(request.args.get("days", 7))
        if days not in (7, 30, 90):
            days = 7
    except (ValueError, TypeError):
        days = 7

    # Parallel-friendly: call all service functions
    kpis = get_kpi_summary(kitchen_id, days)
    trend = get_trend(kitchen_id, days)
    platforms = get_platform_breakdown(kitchen_id, days)
    integrations = get_integration_status(kitchen_id)

    return jsonify({
        "period_days": days,
        "kpis": kpis,
        "trend": trend,
        "platforms": platforms,
        "integrations": integrations,
    })
