<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KitchenIQ Pro - Data Analyst Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            900: '#0c4a6e',
                        },
                        dark: '#0f172a',
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
    </style>
    
    <!-- KitchenIQ Pro Custom Styles -->
    <link rel="stylesheet" href="css/dashboard-pro.css">
</head>
<body class="bg-slate-50 font-sans text-slate-800 h-screen flex overflow-hidden selection:bg-brand-500 selection:text-white">

    <!-- Sidebar -->
    <aside id="sidebar" class="bg-dark text-slate-300 w-64 flex-shrink-0 flex flex-col h-full transition-transform duration-300 z-50 fixed md:relative -translate-x-full md:translate-x-0">
        <div class="h-16 flex items-center px-6 border-b border-slate-700/50 bg-slate-900">
            <div class="bg-brand-500 p-1.5 rounded-lg mr-3">
                <i class="fa-solid fa-utensils text-white text-lg"></i>
            </div>
            <span class="text-white font-bold text-xl tracking-tight">KitchenIQ <span class="text-brand-500">Pro</span></span>
            <button id="closeSidebar" class="md:hidden ml-auto text-slate-400 hover:text-white">
                <i class="fa-solid fa-times text-lg"></i>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto py-6 px-3 space-y-1">
            <a href="#" class="flex items-center px-3 py-2.5 bg-brand-500/10 text-brand-500 rounded-lg group border-l-2 border-brand-500 transition-colors">
                <i class="fa-solid fa-chart-pie w-6 text-center mr-2"></i>
                <span class="font-medium text-sm">Dashboard</span>
            </a>
            <a href="analytics.html" class="flex items-center px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <i class="fa-solid fa-chart-line w-6 text-center mr-2"></i>
                <span class="font-medium text-sm">Analytics</span>
            </a>
            <a href="items.html" class="flex items-center px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <i class="fa-solid fa-burger w-6 text-center mr-2"></i>
                <span class="font-medium text-sm">Dishes</span>
            </a>
            <a href="customers.html" class="flex items-center px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <i class="fa-solid fa-users w-6 text-center mr-2"></i>
                <span class="font-medium text-sm">Customers</span>
            </a>
            <a href="finance.html" class="flex items-center px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <i class="fa-solid fa-indian-rupee-sign w-6 text-center mr-2"></i>
                <span class="font-medium text-sm">Finance</span>
            </a>
            
            <div class="pt-4 pb-2">
                <p class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">System</p>
            </div>
            
            <a href="#" class="flex items-center justify-between px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <div class="flex items-center">
                    <i class="fa-solid fa-plug w-6 text-center mr-2"></i>
                    <span class="font-medium text-sm">Integrations</span>
                </div>
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            </a>
            <a href="insights.html" class="flex items-center justify-between px-3 py-2.5 text-slate-400 hover:bg-slate-800 hover:text-slate-100 rounded-lg group transition-colors border-l-2 border-transparent">
                <div class="flex items-center">
                    <i class="fa-solid fa-lightbulb w-6 text-center mr-2"></i>
                    <span class="font-medium text-sm">Insights</span>
                </div>
                <span class="bg-brand-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AI</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-800 bg-slate-900/50">
            <a href="#" class="flex items-center px-3 py-2 text-slate-400 hover:text-white transition-colors text-sm">
                <i class="fa-solid fa-gear w-6 mr-2 text-center"></i> Settings
            </a>
            <a href="#" class="flex items-center px-3 py-2 text-slate-400 hover:text-white transition-colors text-sm">
                <i class="fa-solid fa-arrow-right-from-bracket w-6 mr-2 text-center"></i> Logout
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden bg-slate-50 relative">
        
        <!-- Top Header -->
        <header class="h-16 glass-panel border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 shrink-0 z-20 sticky top-0">
            <div class="flex items-center flex-1">
                <button id="openSidebar" class="md:hidden text-slate-500 hover:text-slate-800 mr-4 focus:outline-none">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                
                <div class="hidden sm:flex items-center bg-slate-100 rounded-lg px-3 py-2 w-full max-w-md border border-slate-200 focus-within:border-brand-300 focus-within:ring-2 focus-within:ring-brand-100 transition-all">
                    <i class="fa-solid fa-magnifying-glass text-slate-400 mr-2"></i>
                    <input type="text" placeholder="Search data, queries, or metrics..." class="bg-transparent border-none outline-none text-sm w-full text-slate-700 placeholder-slate-400">
                    <span class="text-xs text-slate-400 font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 ml-2">⌘K</span>
                </div>
            </div>
            
            <div class="flex items-center space-x-3 sm:space-x-5">
                <button class="hidden sm:flex items-center bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm shadow-indigo-200">
                    <i class="fa-solid fa-download mr-2"></i>
                    Export Data <span class="ml-1 opacity-75 font-normal">(CSV/SQL)</span>
                </button>

                <div class="hidden lg:flex items-center bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-600 shadow-sm cursor-pointer hover:bg-slate-50">
                    <i class="fa-regular fa-calendar mr-2 text-slate-400"></i>
                    Last 7 Days
                    <i class="fa-solid fa-chevron-down ml-2 text-[10px] text-slate-400"></i>
                </div>

                <button class="relative text-slate-500 hover:text-slate-700 focus:outline-none">
                    <i class="fa-regular fa-bell text-xl"></i>
                    <span class="absolute top-0 right-0 h-2 w-2 bg-rose-500 rounded-full border border-white"></span>
                </button>
                
                <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

                <div class="flex items-center cursor-pointer">
                    <div class="text-right mr-3 hidden md:block">
                        <p class="text-sm font-bold text-slate-800 leading-tight">Admin Analyst</p>
                        <p class="text-[10px] text-slate-500 uppercase tracking-wide">Data Team</p>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Admin+Analyst&background=0ea5e9&color=fff" alt="Profile" class="h-9 w-9 rounded-full border border-slate-200 shadow-sm">
                </div>
            </div>
        </header>

        <!-- Main Scrollable Content -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 pb-20">
            <div class="max-w-7xl mx-auto">
                
                <div class="mb-6 flex justify-between items-end">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Unified Data Overview</h1>
                        <p class="text-sm text-slate-500 mt-1">Cross-platform metrics and AI insights.</p>
                    </div>
                    <button class="sm:hidden flex items-center bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm font-medium">
                        <i class="fa-solid fa-download mr-1.5"></i> Export
                    </button>
                </div>

                <!-- KPI Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                    <!-- Revenue -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-3">
                            <p class="text-sm font-medium text-slate-500">Total Revenue</p>
                            <div class="h-8 w-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </div>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800"><span id="kpi-revenue">—</span></h3>
                        <div class="flex items-center mt-2 text-xs">
                            <span class="text-slate-400 font-medium flex items-center bg-slate-50 px-1.5 py-0.5 rounded">
                                <i class="fa-solid fa-minus mr-1 text-[10px]"></i> 0%
                            </span>
                            <span class="text-slate-400 ml-2">vs last week</span>
                        </div>
                    </div>

                    <!-- Orders -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-3">
                            <p class="text-sm font-medium text-slate-500">Total Orders</p>
                            <div class="h-8 w-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center">
                                <i class="fa-solid fa-receipt"></i>
                            </div>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800"><span id="kpi-orders">—</span></h3>
                        <div class="flex items-center mt-2 text-xs">
                            <span class="text-slate-400 font-medium flex items-center bg-slate-50 px-1.5 py-0.5 rounded">
                                <i class="fa-solid fa-minus mr-1 text-[10px]"></i> 0%
                            </span>
                            <span class="text-slate-400 ml-2">vs last week</span>
                        </div>
                    </div>

                    <!-- Net Profit -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-3">
                            <p class="text-sm font-medium text-slate-500">Net Profit</p>
                            <div class="h-8 w-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800"><span id="kpi-profit">—</span></h3>
                        <div class="flex items-center mt-2 text-xs">
                            <span class="text-slate-400 font-medium flex items-center bg-slate-50 px-1.5 py-0.5 rounded">
                                <i class="fa-solid fa-minus mr-1 text-[10px]"></i> 0%
                            </span>
                            <span class="text-slate-400 ml-2">vs last week</span>
                        </div>
                    </div>

                    <!-- Rating -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-3">
                            <p class="text-sm font-medium text-slate-500">Avg. Rating</p>
                            <div class="h-8 w-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center">
                                <i class="fa-solid fa-star"></i>
                            </div>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800"><span id="kpi-rating">—</span></h3>
                        <div class="flex items-center mt-2 text-xs">
                            <span class="text-slate-400 font-medium flex items-center bg-slate-50 px-1.5 py-0.5 rounded">
                                <i class="fa-solid fa-minus mr-1 text-[10px]"></i> 0
                            </span>
                            <span class="text-slate-400 ml-2">vs last week</span>
                        </div>
                    </div>
                </div>

                <!-- Platform Integrations -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-6">
                    <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
                        <div>
                            <h2 class="text-base font-bold text-slate-800 flex items-center">
                                <i class="fa-solid fa-network-wired text-brand-500 mr-2"></i> Platform Integrations
                            </h2>
                            <p class="text-xs text-slate-500 mt-1">Live data pipelines status across delivery networks.</p>
                        </div>
                        <a href="#" class="text-sm text-brand-600 hover:text-brand-700 font-medium mt-2 md:mt-0">Manage API Keys &rarr;</a>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Zomato -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-100">
                            <div class="flex items-center">
                                <div class="h-8 w-8 rounded bg-red-100 text-red-600 flex items-center justify-center font-bold italic text-lg mr-3 shadow-sm">Z</div>
                                <div>
                                    <p class="text-sm font-semibold text-slate-800 leading-none">Zomato</p>
                                    <p class="text-[10px] text-slate-400 mt-1 flex items-center"><span class="h-1.5 w-1.5 rounded-full bg-slate-400 mr-1"></span> Loading...</p>
                                </div>
                            </div>
                            <button onclick="syncPipeline(this, 'zomato')" class="text-xs font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-600 px-2.5 py-1.5 rounded shadow-sm transition-colors">
                                <i class="fa-solid fa-rotate mr-1"></i> Sync
                            </button>
                        </div>
                        
                        <!-- Swiggy -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-100">
                            <div class="flex items-center">
                                <div class="h-8 w-8 rounded bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-lg mr-3 shadow-sm">S</div>
                                <div>
                                    <p class="text-sm font-semibold text-slate-800 leading-none">Swiggy</p>
                                    <p class="text-[10px] text-slate-400 mt-1 flex items-center"><span class="h-1.5 w-1.5 rounded-full bg-slate-400 mr-1"></span> Loading...</p>
                                </div>
                            </div>
                            <button onclick="syncPipeline(this, 'swiggy')" class="text-xs font-medium bg-white border border-slate-200 hover:bg-slate-100 text-slate-600 px-2.5 py-1.5 rounded shadow-sm transition-colors">
                                <i class="fa-solid fa-rotate mr-1"></i> Sync
                            </button>
                        </div>

                        <!-- Uber Eats -->
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-100 opacity-80">
                            <div class="flex items-center">
                                <div class="h-8 w-8 rounded bg-green-100 text-green-700 flex items-center justify-center font-bold text-lg mr-3 shadow-sm">U</div>
                                <div>
                                    <p class="text-sm font-semibold text-slate-800 leading-none">Uber Eats</p>
                                    <p class="text-[10px] text-rose-500 mt-1 flex items-center"><span class="h-1.5 w-1.5 rounded-full bg-rose-500 mr-1"></span> Disconnected</p>
                                </div>
                            </div>
                            <button class="text-xs font-medium bg-slate-800 hover:bg-slate-900 text-white px-2.5 py-1.5 rounded shadow-sm transition-colors">
                                Connect
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Main Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <!-- Left Column -->
                    <div class="lg:col-span-2 space-y-6">
                        
                        <!-- Trend Chart -->
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between items-center mb-4">
                                <div>
                                    <h2 class="text-base font-bold text-slate-800">Revenue & Profit Trend</h2>
                                    <p class="text-xs text-slate-500">Aggregated performance (Last 7 Days)</p>
                                </div>
                                <select id="trend-period" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg px-2 py-1 outline-none focus:border-brand-300">
                                    <option value="7">7 Days</option>
                                    <option value="30">30 Days</option>
                                    <option value="90">90 Days</option>
                                </select>
                            </div>
                            <div class="h-64 w-full relative">
                                <canvas id="trendChart"></canvas>
                            </div>
                        </div>

                        <!-- Platform Bar Chart -->
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between items-center mb-4">
                                <div>
                                    <h2 class="text-base font-bold text-slate-800">Platform-wise Revenue & Commission</h2>
                                    <p class="text-xs text-slate-500">Gross revenue vs Platform fees & commissions</p>
                                </div>
                            </div>
                            <div class="h-64 w-full relative">
                                <canvas id="platformBarChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: AI Insights -->
                    <div class="space-y-6">
                        <div class="bg-gradient-to-b from-white to-brand-50/30 rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col h-full max-h-[800px]">
                            <div class="p-4 border-b border-slate-200 bg-white">
                                <div class="flex items-center">
                                    <div class="bg-brand-100 p-1.5 rounded mr-2">
                                        <i class="fa-solid fa-wand-magic-sparkles text-brand-600 text-sm"></i>
                                    </div>
                                    <h2 class="text-base font-bold text-slate-800">AI Business Insights</h2>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">Smart recommendations based on your data.</p>
                            </div>
                            
                            <div id="insights-container" class="p-4 space-y-4 overflow-y-auto flex-1">
                                <div class="text-center text-slate-400 text-xs py-8">
                                    <i class="fa-solid fa-circle-notch fa-spin text-2xl mb-2"></i>
                                    <p>Loading insights...</p>
                                </div>
                            </div>
                            
                            <div class="p-3 bg-slate-50 border-t border-slate-200 text-center">
                                <a href="insights.html" class="text-xs font-semibold text-brand-600 hover:text-brand-800">View All Insights &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Mobile Sidebar Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <!-- KitchenIQ Pro Dashboard Script -->
    <script src="js/dashboard-pro.js"></script>
</body>
</html>